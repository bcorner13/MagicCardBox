# -*- coding: utf-8 -*-
"""
41-export_matrix.FCMacro

Exports the whole product matrix in one run: {MTG 100, MTG 60, Alchemy 60}
x {smooth, fluted, fluted-label} surfaces = 9 variants, STL + 3MF each.

CARD SIZE IS PER-VARIANT (2026-11-14, Alchemy). CardLength / CardWidth live in
the MATRIX beside CardCount / CardPitch. Width and Depth derive from them, so an
Alchemy row changes the box from 111 x 73 to 143 x 97. Alchemy rows are LAST so
the model makes ONE trip to the large size and back.
  - Macro 58 must be in the model first: before it, Sketch013's ramp pole could
    solve to its MIRROR position after a size round trip (+150.885 mm3, silent).
  - The ASSEMBLY IS NOT RECOMPUTED here. Recomputing it at the Alchemy size
    re-derives the joint's Placement1 from the large lid (69.5, 43.5, 5) and
    leaves it stale after the restore - observed 2026-11-14. The export builds
    its own pose and never reads the assembly.

WHY THIS REPLACES THE MANUAL CYCLE
  The old procedure was: set CardCount, flip Pocket009.Suppressed in BOTH
  documents, run macro 16, call export_3mf, call export_stl, repeat. Seven
  steps per variant. At four variants that was tedious; at six it is forty-plus
  steps and every one is a chance to write the wrong state into a file. That
  is not hypothetical - on 2026-09-14 a file was exported carrying the name
  plate while named "-fluted".

  This macro drives the matrix from a TABLE. Adding a seventh variant is one
  row, not a new procedure.

WHY IT EXPORTS ITSELF INSTEAD OF DEFERRING TO THE TYPED TOOLS
  Macro 16 deliberately leaves the writing to export_3mf / export_stl so a
  locally tessellated facet count cannot disagree with theirs. That separation
  is what forces the manual dance - and it costs real verification: macro 16
  can only dimension-check the variant CURRENTLY LOADED, so every other
  variant gets structural checks only.

  Exporting in-loop means each file is written AND fully checked while the
  model is in that exact state, so all six get bbox and volume checks, not
  one. It also retires a known-weak gate: on 2026-09-15 a stale 100-fluted
  file missing the entire name plate measured +0.95% against macro 16's 1%
  volume tolerance and passed.

WHY IT WRITES A REPORT FILE
  Six variants is minutes of recompute, far past the MCP bridge's 30 s
  response cap. The macro keeps running in FreeCAD after the response is lost
  (observed repeatedly this session), so it writes REPORT as JSON and the
  caller polls for it. The cap stops mattering.

  REPORT lands at  <project>/gcode/export_matrix.json  — poll that.
  It used to be a session-specific temp path; see the note beside REPORT for
  why a path that keeps working is not the same as a path that is correct.

THE TWO SWITCHES
  flutes    Pocket009.Suppressed  in BOTH MagicCardBox and Lid
  label     PocketNamePlate.Suppressed in Lid

  Both features sit at the TIP of their bodies (macros 24, 38), which is what
  makes them suppressible without disturbing any edge reference.

RESTORES THE STATE IT FOUND (was: a CANONICAL 100-card state)
  Always, even on failure. It used to restore CANONICAL, which silently left
  memory on a different card count from disk with nothing Touched (round 13).
  It now captures the loaded variant at start and puts THAT back, then proves
  it with a boolean comparison of all three bodies against their start shapes.
"""

import importlib
import json
import os
import sys
import traceback

import FreeCAD
import Part
import Mesh
import MeshPart
from FreeCAD import Vector

PROJ = "/Users/bradleycorner/Documents/3dPrinting/Commercial License/MagicCardBox"
# Beside the project, NOT in a session scratchpad.
#
# This was pinned to /private/tmp/.../<session-uuid>/scratchpad/ — a path whose
# UUID died with the session that created it. The macro went on WORKING, because
# makedirs(exist_ok=True) happily recreated the dead directory, so it wrote a
# perfectly good report somewhere nobody would ever look. A caller polling the
# obvious location would have concluded the export had failed.
#
# gcode/ is gitignored (`gcode/*`), so the report stays untracked and
# regenerable, which is what it is.
REPORT = os.path.join(PROJ, "gcode", "export_matrix.json")

NOZZLE = 0.4
BED = 350.0
VOL_TOL = 0.01

# CardPitch IS A PROPERTY OF THE SLEEVE, NOT OF THE DESIGN - so it lives in this
# table beside CardCount, not as one global constant.
#
#   thin sleeve   true 0.6040   CardPitch 0.6200   slack 0.0160 mm/card
#   Ryan's        true 0.6867   CardPitch 0.7033   slack 0.0163 mm/card
#
# Both carry the SAME per-card slack; they differ only in the sleeve measured.
# Evidence: the printed 100 box holds 101 cards with ~2 mm still free at the top
# (-> 0.604), while Ryan's 60 box came up 5 mm short (-> 0.687). A single global
# pitch cannot satisfy both, and forcing one makes the 100 box hold ~114 cards.
#
# ASSUMPTION, stated rather than buried: the 60-card products are built for
# Ryan's thicker sleeve and the 100-card products for the thin one. If a given
# product needs the other sleeve, change its pitch HERE - that is the whole edit.
THIN_SLEEVE = 0.62
THICK_SLEEVE = 0.7033

# CARD SIZE, per product family. MTG 93 x 66 is the sleeved size (CardWidth 66
# still an ASSUMPTION - see CLAUDE.md). Alchemy 125 x 90 is BARE (unsleeved),
# Bradley 2026-11-14. Alchemy uses THICK_SLEEVE pitch BY CHOICE, to keep the
# MTG-60 internal height of 43.198 - a bare card is likely ~0.3 mm, so a
# measured Alchemy stack may justify its own pitch later.
MTG = (93.0, 66.0)
ALCHEMY = (125.0, 90.0)

#        cards, pitch,        card size, flutes, label, tag
MATRIX = [(100, THIN_SLEEVE,  MTG,     False, False, "100-smooth"),
          (100, THIN_SLEEVE,  MTG,     True,  False, "100-fluted"),
          (100, THIN_SLEEVE,  MTG,     True,  True,  "100-fluted-label"),
          (60,  THICK_SLEEVE, MTG,     False, False, "60-smooth"),
          (60,  THICK_SLEEVE, MTG,     True,  False, "60-fluted"),
          (60,  THICK_SLEEVE, MTG,     True,  True,  "60-fluted-label"),
          (60,  THICK_SLEEVE, ALCHEMY, False, False, "alchemy60-smooth"),
          (60,  THICK_SLEEVE, ALCHEMY, True,  False, "alchemy60-fluted"),
          (60,  THICK_SLEEVE, ALCHEMY, True,  True,  "alchemy60-fluted-label")]

# Fallback only - the macro restores the state it FOUND (see header).
CANONICAL = (100, THIN_SLEEVE, MTG, True, True, "100-fluted-label")


def current_variant():
    mb = FreeCAD.getDocument("MagicCardBox")
    ld = FreeCAD.getDocument("Lid")
    vs = FreeCAD.getDocument("Params").getObject("VarSet")
    return (int(vs.CardCount), float(vs.CardPitch.Value),
            (float(vs.CardLength.Value), float(vs.CardWidth.Value)),
            not mb.getObject("Pocket009").Suppressed,
            not ld.getObject("PocketNamePlate").Suppressed, "as-found")


def set_variant(cards, pitch, size, flutes, label):
    mb = FreeCAD.getDocument("MagicCardBox")
    ld = FreeCAD.getDocument("Lid")
    vs = FreeCAD.getDocument("Params").getObject("VarSet")
    vs.CardCount = cards
    vs.CardPitch = pitch
    vs.CardLength = size[0]
    vs.CardWidth = size[1]
    mb.getObject("Pocket009").Suppressed = not flutes
    ld.getObject("Pocket009").Suppressed = not flutes
    ld.getObject("PocketNamePlate").Suppressed = not label
    for dn in ("Params", "Lid", "MagicCardBox"):        # NOT the assembly - see header
        FreeCAD.getDocument(dn).recompute()
    bad = []
    for dn in ("Lid", "MagicCardBox"):
        for o in FreeCAD.getDocument(dn).Objects:
            st = o.State or []
            if "Invalid" in st or "Error" in st:
                bad.append("%s/%s" % (dn, o.Name))
    return bad


def posed_compound():
    """Box + lid folded open 90 deg, sat on Z=0 and centred. Same pose as macro 16."""
    mb = FreeCAD.getDocument("MagicCardBox")
    ld = FreeCAD.getDocument("Lid")
    vs = FreeCAD.getDocument("Params").getObject("VarSet")
    aY = vs.Depth.Value / 2 - vs.HingeAxisFromRear.Value
    aZ = vs.HingeAxisFromBottom.Value
    box = mb.getObject("Body").Shape.copy()
    lid = ld.getObject("Body").Shape.fuse(ld.getObject("Body001").Shape)
    lid = lid.removeSplitter()
    if len(lid.Solids) != 1:
        raise RuntimeError("lid did not fuse into one solid (%d)" % len(lid.Solids))
    lid.rotate(Vector(0, aY, aZ), Vector(1, 0, 0), -90)
    gap = box.distToShape(lid)[0]
    for tag, s in (("box", box), ("lid", lid)):
        if not (s.isValid() and s.isClosed()):
            raise RuntimeError("%s is not a valid closed solid" % tag)
    comb = Part.makeCompound([box, lid])
    b = comb.BoundBox
    comb.translate(Vector(-(b.XMin + b.XMax) / 2.0, -(b.YMin + b.YMax) / 2.0, -b.ZMin))
    return comb, gap


def tight_bbox(shape, dev=0.05):
    """Bounding box from a TESSELLATION, not Shape.BoundBox.

    OCC pads BoundBox on a COPIED shape from control points rather than the
    trimmed surface. Measured 2026-09-15 on this box:

        Shape.BoundBox          116.8123   correct
        Shape.copy().BoundBox   123.9613   inflated 7.15 mm
        optimalBoundingBox()    119.7185   also inflated
        tessellation            116.8123   correct

    posed_compound() builds from .copy() shapes, so the padded value was being
    compared against the STL's exact mesh bbox and every variant failed on a
    bbox that was never wrong. Tessellating measures the same thing the mesh
    does, so the two are directly comparable.
    """
    pts = shape.tessellate(dev)[0]
    xs = [q.x for q in pts]; ys = [q.y for q in pts]; zs = [q.z for q in pts]
    return (max(xs) - min(xs), max(ys) - min(ys), max(zs) - min(zs),
            min(xs), min(ys), min(zs))


def tris_in_3mf(path):
    import re
    import zipfile
    try:
        with zipfile.ZipFile(path) as z:
            nm = next((n for n in z.namelist() if n.endswith("3dmodel.model")), None)
            if nm is None:
                return None
            return len(re.findall(r"<triangle\b", z.read(nm).decode("utf-8", "replace")))
    except Exception:
        return None


def run():
    results = []
    for cards, pitch, size, flutes, label, tag in MATRIX:
        row = {"tag": tag, "cards": cards, "pitch": pitch, "card_size": list(size),
               "flutes": flutes, "label": label, "problems": []}
        try:
            bad = set_variant(cards, pitch, size, flutes, label)
            if bad:
                row["problems"].append("invalid after recompute: %s" % bad)

            comb, gap = posed_compound()
            row["gap"] = round(gap, 4)
            if gap < NOZZLE - 1e-6:
                row["problems"].append("print-pose gap %.4f < nozzle %.2f" % (gap, NOZZLE))
            xl, yl, zl, _, _, _ = tight_bbox(comb)
            row["bbox"] = [round(xl, 2), round(yl, 2), round(zl, 2)]
            row["volume_mm3"] = round(comb.Volume, 2)
            if xl > BED or yl > BED:
                row["problems"].append("footprint exceeds bed")

            doc = FreeCAD.newDocument("MCB_Exp")
            try:
                obj = doc.addObject("Part::Feature", "part")
                obj.Shape = comb
                doc.recompute()
                stl = os.path.join(PROJ, "stl", "MagicCardBox-%s.stl" % tag)
                tmf = os.path.join(PROJ, "3mf", "MagicCardBox-%s.3mf" % tag)
                Mesh.export([obj], stl)
                Mesh.export([obj], tmf)
            finally:
                FreeCAD.closeDocument("MCB_Exp")

            m = Mesh.Mesh(stl)
            row["facets"] = m.CountFacets
            row["mesh_volume_cm3"] = round(m.Volume / 1000.0, 2)
            row["components"] = m.countComponents()
            row["on_z"] = round(m.BoundBox.ZMin, 3)
            if not m.isSolid():
                row["problems"].append("stl not watertight")
            if m.hasNonManifolds():
                row["problems"].append("stl non-manifold")
            if m.hasSelfIntersections():
                row["problems"].append("stl self-intersecting")
            if m.countComponents() != 2:
                row["problems"].append("stl has %d components, expected 2" % m.countComponents())
            got = [round(m.BoundBox.XLength, 2), round(m.BoundBox.YLength, 2),
                   round(m.BoundBox.ZLength, 2)]
            if got != row["bbox"]:
                row["problems"].append("stl bbox %s != posed %s" % (got, row["bbox"]))
            dv = abs(m.Volume - comb.Volume) / comb.Volume
            row["vol_delta_pct"] = round(dv * 100.0, 3)
            if dv > VOL_TOL:
                row["problems"].append("stl volume %.2f%% off the posed solid" % (dv * 100.0))
            t = tris_in_3mf(tmf)
            row["3mf_tris"] = t
            if t is None:
                row["problems"].append("3mf unreadable or has no 3dmodel.model")
            elif t == 0:
                row["problems"].append("3MF HAS NO GEOMETRY - a slicer project, not an export")
            elif t != m.CountFacets:
                row["problems"].append("3mf %d tris != stl %d facets" % (t, m.CountFacets))
        except Exception:
            row["problems"].append("EXCEPTION: %s" % traceback.format_exc()[-400:])
        row["ok"] = not row["problems"]
        results.append(row)
    return results


def body_shapes():
    return {"box": FreeCAD.getDocument("MagicCardBox").getObject("Body").Shape.copy(),
            "lid_plate": FreeCAD.getDocument("Lid").getObject("Body").Shape.copy(),
            "lid_back": FreeCAD.getDocument("Lid").getObject("Body001").Shape.copy()}


def joint_p1():
    return str(FreeCAD.getDocument("MagicCardAssembly").getObject("Joint").Placement1)


out = {"results": [], "restored": None, "error": None}
start_variant = start_shapes = start_p1 = None
try:
    sys.path.insert(0, os.path.join(PROJ, "scripts"))
    import test_env_guard
    importlib.reload(test_env_guard)
    out["banner"] = test_env_guard.require_laptop(need_freecad=True)
    start_variant = current_variant()
    start_shapes = body_shapes()
    start_p1 = joint_p1()
    out["start_variant"] = [start_variant[0], start_variant[1], list(start_variant[2]),
                            start_variant[3], start_variant[4]]
    out["results"] = run()
except Exception:
    out["error"] = traceback.format_exc()[-800:]
finally:
    restore_ok = False
    try:
        v = start_variant or CANONICAL
        set_variant(v[0], v[1], v[2], v[3], v[4])
        out["restored"] = v[5]
        if start_shapes is not None:
            now = body_shapes()
            diff = {k: [start_shapes[k].cut(now[k]).Volume, now[k].cut(start_shapes[k]).Volume]
                    for k in now}
            out["restore_boolean_diff"] = diff
            out["joint_p1"] = [start_p1, joint_p1()]
            restore_ok = all(max(d) <= 1e-3 for d in diff.values()) and start_p1 == joint_p1()
            if not restore_ok:
                out["restored"] = ("RESTORE DID NOT RETURN TO START - close all four "
                                   "documents WITHOUT saving")
    except Exception:
        out["restored"] = "RESTORE FAILED: " + traceback.format_exc()[-400:]
    out["all_ok"] = bool(out["results"]) and all(r["ok"] for r in out["results"]) \
        and out["error"] is None and restore_ok
    try:
        os.makedirs(os.path.dirname(REPORT), exist_ok=True)
        with open(REPORT, "w") as fh:
            json.dump(out, fh, indent=1)
    except Exception:
        pass
    print(json.dumps(out, indent=1)[:2000])
