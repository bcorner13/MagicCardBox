# -*- coding: utf-8 -*-
"""
62 - TEARDROP the top of the box's hinge socket (2026-11-22)

WHY
---
Both 2026-11-22 PETG prints (Core One L 60-fluted, K2 alchemy100-fluted) came off
with the LEFT knuckle slightly fused; the 2026-11-16 Alchemy print stuck on the
RIGHT. The solids are symmetric (measured 2026-11-17), so a fixed one-sided cause
does not fit. Bradley, looking at the parts: "the gap at the top of the hinge is
slightly less than the rest of the gap", plus slight droop in the inside gap.

The socket is a hole with a HORIZONTAL axis (X) in the print pose. The top of such a
hole is an arch printed over air: it sags, and the 0.4 mm HingeTabClearance closes
up there first. Both knuckles end up marginal; chance picks which one welds.

Measured before this macro (box tip, x = 50.6..55.0, all identical): the ceiling over
the knuckle follows the R5.4 bore up to y ~ 31 (z 10.0-10.4, near-horizontal), and
only rises beyond that where BackHengeFilet R8 rolls it out toward the rear face.
So the flat-ish part of the arch is the FRONT half, y ~ 28-31.

WHAT
----
A 45 deg pointed cap (teardrop) on top of the socket bore, appended at the TIP as
its own sketch -> pocket -> mirror, so:
  * no existing named-edge reference is disturbed (macro 24/37/55 reasoning);
  * suppressing the three features restores the previous box exactly.

  profile = arc of the bore circle (45..135 deg) + two lines tangent to it at its
            ends, meeting at an apex directly above the hinge axis.
  apex z  = HingeAxisFromBottom + r / sin(SocketTeardropAngle)   (r = bore radius)
          = 5 + 5.4 * sqrt(2) = 12.637 at 45 deg

  The arc is DELIBERATELY coincident with the bore (same expression as
  HingProfile Constraints[2]): the cap must continue the bore with no step. This is
  the "must stay coincident" case, not the coincidence trap.

  Depth = HingeTabThickness + HingeTabClearance, same as the socket, so the cap's
  floor lands on the socket floor and does not thin the 2.6 mm web to the cavity.

New Param:
  SocketTeardropAngle 45 deg   FREE DESIGN INPUT - the steepest overhang this
                               printer bridges cleanly. Not a clearance.

The knuckle still turns on the round lower ~270 deg of the bore; only the top of the
socket gets extra room, which is exactly where the print sags.

The cap opens through the box's outer side face (the socket already does), so a
small pointed gap shows above each knuckle from outside.

GATES: banner; no partial docs; sketch DoF 0 and no redundant/conflicting/malformed;
apex measured on the sketch; removed volume > 0 and the same on both sides; tip
valid/closed/1 solid; chain-invalid count must not grow; Group == BaseFeature chain;
ceiling probed on the SOLID at both knuckles; LidBack + plate swing 0-90 deg: zero
interference and the gap may not drop (box material is only removed); mesh @0.02.

WRITES macros/62-report.json. NOTHING IS SAVED.
"""

import importlib
import json
import math
import os
import sys
import time

import FreeCAD as App
import Part
import Sketcher

MACRO = "62-socket_teardrop"
DOC_NAME = "MagicCardBox"
SK_NAME, POCKET_NAME, MIRROR_NAME = ("SketchSocketTeardrop", "PocketSocketTeardrop",
                                     "MirroredSocketTeardrop")
ANGLE_NAME, ANGLE_VALUE = "SocketTeardropAngle", 45.0
P = "<<Params>>#VarSet."
SWING_ANGLES = [0.0, 2.0, 8.0, 15.0, 30.0, 45.0, 60.0, 75.0, 90.0]
GAP_EPS = 1e-4
MESH_DEV = 0.02

doc = App.getDocument(DOC_NAME)
PROJ = os.path.dirname(os.path.abspath(doc.FileName))
REPORT = os.path.join(PROJ, "macros", "62-report.json")
log = []


def p(msg):
    log.append(str(msg))
    App.Console.PrintMessage("[62] %s\n" % msg)


class Abort(RuntimeError):
    pass


def write_report(status, extra=None):
    data = {"macro": MACRO, "status": status,
            "when": time.strftime("%Y-%m-%d %H:%M:%S"), "log": log}
    data.update(extra or {})
    with open(REPORT, "w") as fh:
        json.dump(data, fh, indent=2, default=str)


def chain_invalid(b):
    bad = []
    for o in b.Group:
        if hasattr(o, "BaseFeature"):
            try:
                if not o.Shape.isValid():
                    bad.append(o.Name)
            except Exception:
                bad.append(o.Name)
    return bad


def check_chain(body):
    feats = [o for o in body.Group if hasattr(o, "BaseFeature")]
    roots = [o for o in feats if o.BaseFeature is None]
    if len(roots) != 1:
        raise Abort("expected 1 chain root, found %d" % len(roots))
    order, seen, cur = [], set(), roots[0]
    while cur is not None:
        if cur.Name in seen:
            raise Abort("BaseFeature CYCLE at %s" % cur.Name)
        seen.add(cur.Name)
        order.append(cur)
        nxt = [o for o in feats if o.BaseFeature is cur]
        if len(nxt) > 1:
            raise Abort("chain forks at %s" % cur.Name)
        cur = nxt[0] if nxt else None
    if [o.Name for o in order] != [o.Name for o in feats]:
        raise Abort("Group order != BaseFeature chain")
    if body.Tip is not order[-1]:
        raise Abort("Tip %s is not the chain end %s" % (body.Tip.Name, order[-1].Name))
    return len(order)


def ceiling(shape, x, y, z0):
    """Lowest box material above (x, y, z0) - the socket ceiling."""
    ln = Part.LineSegment(App.Vector(x, y, z0), App.Vector(x, y, z0 + 25.0)).toShape()
    zs = [e.BoundBox.ZMin for e in shape.common(ln).Edges]
    return min(zs) if zs else None


try:
    sys.path.insert(0, os.path.join(PROJ, "scripts"))
    import test_env_guard
    importlib.reload(test_env_guard)
    banner = test_env_guard.require_laptop(need_freecad=True)
    p(banner)

    partial = [d.Name for d in App.listDocuments().values() if d.Partial]
    if partial:
        raise Abort("partial documents never recompute: %s - Close All and reopen"
                    % partial)

    params = App.getDocument("Params")
    vs = params.getObject("VarSet")
    G = lambda n: float(getattr(vs, n))
    body = doc.getObject("Body")
    lid = App.getDocument("Lid")
    bore_sk = doc.getObject("Sketch001")          # HingProfile - the socket bore

    # ------------------------------------------------------------ 1. Param
    if ANGLE_NAME not in vs.PropertiesList:
        vs.addProperty("App::PropertyAngle", ANGLE_NAME, "Hinge",
                       "Overhang angle of the pointed cap on top of the box hinge "
                       "socket (macro 62). The socket prints as a sideways hole; its "
                       "arched top sags and closed HingeTabClearance there on the "
                       "2026-11-22 PETG prints. FREE DESIGN INPUT, not a clearance.")
        setattr(vs, ANGLE_NAME, ANGLE_VALUE)
        p("added Param %s = %.1f deg" % (ANGLE_NAME, ANGLE_VALUE))
    ta = G(ANGLE_NAME)
    if not 30.0 <= ta <= 60.0:
        raise Abort("%s %.1f outside 30..60 deg" % (ANGLE_NAME, ta))

    cy = G("Depth") / 2.0 - G("HingeAxisFromRear")
    cz = G("HingeAxisFromBottom")
    r = G("HingeTabRadius") + G("HingeTabClearance")
    apex_z = cz + r / math.sin(math.radians(ta))
    p("bore centre (%.4f, %.4f) r %.4f -> expected apex z %.4f" % (cy, cz, r, apex_z))

    # ----------------------------------------------------- 2. baseline
    old_tip = body.Tip
    existing = doc.getObject(MIRROR_NAME)
    base = old_tip
    for n in (MIRROR_NAME, POCKET_NAME):         # re-run: baseline is BELOW us
        if base is not None and base.Name == n:
            base = base.BaseFeature
    if base is None:
        raise Abort("no base feature")
    base_shape = base.Shape.copy()
    before_invalid = chain_invalid(body)
    p("baseline %s vol %.4f ; chain-invalid %d %s"
      % (base.Name, base_shape.Volume, len(before_invalid), before_invalid))

    # ----------------------------------------------------- 3. sketch
    sk = doc.getObject(SK_NAME)
    if sk is None:
        sk = body.newObject("Sketcher::SketchObject", SK_NAME)
        p("created %s" % SK_NAME)
    sk.AttachmentSupport = bore_sk.AttachmentSupport
    sk.MapMode = bore_sk.MapMode
    sk.AttachmentOffset = bore_sk.AttachmentOffset
    sk.setExpression(".AttachmentOffset.Base.z", P + "Width / 2")

    a0, a1 = math.radians(90.0 - (90.0 - ta)), math.radians(90.0 + (90.0 - ta))
    # tangent points sit at 90 +/- (90 - ta) on the circle
    sk.deleteAllGeometry()
    arc = Part.ArcOfCircle(Part.Circle(App.Vector(cy, cz, 0), App.Vector(0, 0, 1), r),
                           math.radians(ta), math.radians(180.0 - ta))
    t2 = App.Vector(cy + r * math.cos(math.radians(ta)), cz + r * math.sin(math.radians(ta)), 0)
    t1 = App.Vector(cy - r * math.cos(math.radians(ta)), cz + r * math.sin(math.radians(ta)), 0)
    apex = App.Vector(cy, apex_z, 0)
    g_arc = sk.addGeometry(arc, False)
    g_l1 = sk.addGeometry(Part.LineSegment(t1, apex), False)
    g_l2 = sk.addGeometry(Part.LineSegment(apex, t2), False)
    C = Sketcher.Constraint
    cons = [
        C("DistanceX", -1, 1, g_arc, 3, cy),                       # 0
        C("DistanceY", -1, 1, g_arc, 3, cz),                       # 1
        C("Radius", g_arc, r),                                      # 2
        C("Tangent", g_arc, 2, g_l1, 1),                            # 3  T1
        C("Tangent", g_l2, 2, g_arc, 1),                            # 4  T2
        C("Coincident", g_l1, 2, g_l2, 1),                          # 5  apex
        C("Angle", g_l1, math.radians(ta)),                         # 6
        # 7: second line mirrors the first, so the apex lands above the axis.
        # NOT DistanceX(centre, apex) = 0 - that is an unbound literal (audit).
        C("Angle", g_l2, -math.radians(ta)),                        # 7
    ]
    for c in cons:
        sk.addConstraint(c)
    sk.setExpression("Constraints[0]", P + "Depth / 2 - " + P + "HingeAxisFromRear")
    sk.setExpression("Constraints[1]", P + "HingeAxisFromBottom")
    sk.setExpression("Constraints[2]", P + "HingeTabRadius + " + P + "HingeTabClearance")
    sk.setExpression("Constraints[6]", P + ANGLE_NAME)
    sk.setExpression("Constraints[7]", "-" + P + ANGLE_NAME)
    doc.recompute()
    sk.solve()
    if sk.DoF != 0 or sk.RedundantConstraints or sk.ConflictingConstraints \
            or sk.MalformedConstraints:
        raise Abort("sketch not cleanly constrained: DoF %s red %s conf %s mal %s"
                    % (sk.DoF, sk.RedundantConstraints, sk.ConflictingConstraints,
                       sk.MalformedConstraints))
    ap = sk.Geometry[g_l1].EndPoint
    if abs(ap.x - cy) > 1e-6 or abs(ap.y - apex_z) > 1e-6:
        raise Abort("apex solved to (%.4f, %.4f), expected (%.4f, %.4f) - the solver "
                    "took another root" % (ap.x, ap.y, cy, apex_z))
    p("sketch DoF 0, apex (%.4f, %.4f)" % (ap.x, ap.y))

    # ----------------------------------------------------- 4. pocket + mirror
    pk = doc.getObject(POCKET_NAME)
    if pk is None:
        pk = body.newObject("PartDesign::Pocket", POCKET_NAME)
        p("created %s" % POCKET_NAME)
    pk.Profile = sk
    pk.Type = "Length"
    pk.SideType = "One side"
    pk.Reversed = doc.getObject("Pocket").Reversed
    pk.setExpression("Length", P + "HingeTabThickness + " + P + "HingeTabClearance")
    pk.BaseFeature = base

    mi = doc.getObject(MIRROR_NAME)
    if mi is None:
        mi = body.newObject("PartDesign::Mirrored", MIRROR_NAME)
        p("created %s" % MIRROR_NAME)
    mi.Originals = [pk]
    mi.MirrorPlane = doc.getObject("MirroredNeckClip").MirrorPlane
    mi.BaseFeature = pk

    grp = [o for o in body.Group if o not in (sk, pk, mi)] + [sk, pk, mi]
    body.Group = grp
    body.Tip = mi
    doc.recompute()

    # ----------------------------------------------------- 5. gates
    for o in (sk, pk, mi):
        if "Invalid" in o.State:
            raise Abort("%s Invalid after recompute" % o.Name)
    sh = mi.Shape
    if not (sh.isValid() and sh.isClosed() and len(sh.Solids) == 1):
        raise Abort("tip not valid/closed/1 solid: %s %s %d"
                    % (sh.isValid(), sh.isClosed(), len(sh.Solids)))
    n = check_chain(body)
    p("chain OK, %d features, tip %s" % (n, body.Tip.Name))
    after_invalid = chain_invalid(body)
    p("chain-invalid after %d %s" % (len(after_invalid), after_invalid))
    if len(after_invalid) > len(before_invalid):
        raise Abort("shape-invalid count GREW %d -> %d"
                    % (len(before_invalid), len(after_invalid)))

    removed = base_shape.cut(sh)
    added = sh.cut(base_shape).Volume
    rp = sum(s.Volume for s in removed.Solids if s.BoundBox.Center.x > 0)
    rn = sum(s.Volume for s in removed.Solids if s.BoundBox.Center.x < 0)
    cap_max = r * r * (1.0 / math.tan(math.radians(ta)) - math.radians(90.0 - ta)) \
        * (G("HingeTabThickness") + G("HingeTabClearance"))
    p("removed +x %.4f  -x %.4f mm3 (full cap would be %.4f per side); added %.6f"
      % (rp, rn, cap_max, added))
    if rp <= 0.5 or abs(rp - rn) > 1e-3 or added > 1e-6:
        raise Abort("cut is wrong: +x %.4f -x %.4f added %.6f (check Reversed)"
                    % (rp, rn, added))
    if rp > cap_max + 1e-3:
        raise Abort("removed more than the cap itself (%.4f > %.4f)" % (rp, cap_max))

    probes = {}
    for x in (+53.0, -53.0):
        sx = math.copysign(G("Width") / 2.0 - 2.5, x)
        row = {}
        for y in (cy - 2.0, cy - 1.0, cy):
            row["y%.1f" % y] = (round(ceiling(base_shape, sx, y, 8.3), 4),
                                round(ceiling(sh, sx, y, 8.3), 4))
        probes["x%+.1f" % sx] = row
    p("socket ceiling (before, after): %s" % probes)
    top_after = [v["y%.1f" % cy][1] for v in probes.values()]
    if any(abs(t - apex_z) > 0.01 for t in top_after):
        raise Abort("ceiling above the axis is %s, expected apex %.4f"
                    % (top_after, apex_z))

    # swing: plate and LidBack separately (rule 1b); before vs after
    axis = App.Vector(0, cy, cz)
    lb = lid.getObject("Body001").Shape
    pl = lid.getObject("Body").Shape
    swing, worst_drop, worst_int = [], 0.0, 0.0
    for ang in SWING_ANGLES:
        row = {"deg": ang}
        for nm, s in (("lidback", lb), ("plate", pl)):
            c = s.copy()
            c.rotate(axis, App.Vector(1, 0, 0), -ang)
            g0 = base_shape.distToShape(c)[0]
            g1 = sh.distToShape(c)[0]
            iv = sh.common(c).Volume
            row[nm] = (round(g0, 4), round(g1, 4), round(iv, 6))
            worst_drop = max(worst_drop, g0 - g1)
            worst_int = max(worst_int, iv)
        swing.append(row)
        p("  %5.1f deg  LidBack gap %s -> %s  | plate gap %s -> %s"
          % (ang, row["lidback"][0], row["lidback"][1], row["plate"][0], row["plate"][1]))
    if worst_int > 1e-4:
        raise Abort("INTERFERENCE %.6f mm3 in the swing" % worst_int)
    if worst_drop > GAP_EPS:
        raise Abort("a gap DROPPED by %.4f - removing box material cannot do that"
                    % worst_drop)

    mesh_info = None
    import MeshPart
    m = MeshPart.meshFromShape(Shape=sh, LinearDeflection=MESH_DEV,
                               AngularDeflection=0.05, Relative=False)
    mesh_info = {"facets": m.CountFacets, "solid": bool(m.isSolid()),
                 "non_manifold": bool(m.hasNonManifolds()),
                 "self_intersect": bool(m.hasSelfIntersections())}
    p("mesh @%.2f %s" % (MESH_DEV, mesh_info))
    if not mesh_info["solid"] or mesh_info["non_manifold"] or mesh_info["self_intersect"]:
        raise Abort("MESH check failed %s" % mesh_info)

    p("OK. tip %s vol %.4f (was %.4f). NOTHING SAVED."
      % (body.Tip.Name, sh.Volume, base_shape.Volume))
    write_report("OK", {"banner": banner, "apex_z": apex_z,
                        "removed_per_side": [rp, rn], "cap_max": cap_max,
                        "ceiling": probes, "swing": swing, "mesh": mesh_info,
                        "invalid_before": before_invalid,
                        "invalid_after": after_invalid})
except Exception as exc:
    import traceback
    p("ABORT: %s" % exc)
    write_report("ABORT", {"error": str(exc), "traceback": traceback.format_exc()})
    raise
